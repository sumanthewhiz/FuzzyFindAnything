<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>..\..\src\FuzzyFindAnything.Engine\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\FuzzyFindAnything.Core\FuzzyFindAnything.Core.csproj" />
    <ProjectReference Include="..\..\src\FuzzyFindAnything.Inference\FuzzyFindAnything.Inference.csproj" />
    <ProjectReference Include="..\..\src\FuzzyFindAnything.Tools\FuzzyFindAnything.Tools.csproj" />
    <Content Include="..\..\artifacts\native\ffa_diskann.dll" Link="ffa_diskann.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\artifacts\native\ffa_diskann.dll')" />
    <Content Include="..\..\artifacts\native\libiomp5md.dll" Link="libiomp5md.dll" CopyToOutputDirectory="PreserveNewest" Condition="Exists('..\..\artifacts\native\libiomp5md.dll')" />
    <EmbeddedResource Include="..\Fixtures\office\*" LogicalName="FuzzyFindAnything.Tests.Office.%(Filename)%(Extension)" />
    <EmbeddedResource Include="..\Fixtures\embedding\*.json" LogicalName="FuzzyFindAnything.Tests.Embedding.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
