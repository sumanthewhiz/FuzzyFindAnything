<Window x:Class="FuzzyFindAnything.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fuzzy Find Anything" WindowState="Maximized" Width="1280" Height="860"
        MinWidth="960" MinHeight="700" Background="{DynamicResource WindowBackground}"
        FontFamily="Segoe UI Variable, Segoe UI" FontSize="14" Foreground="{DynamicResource Ink}"
        Icon="Assets/app.ico" Loaded="Window_Loaded" Closing="Window_Closing"
        AutomationProperties.AutomationId="MainWindow">
  <Window.Resources>
    <DataTemplate x:Key="TextResultTemplate">
      <Button Click="Result_Click" HorizontalContentAlignment="Stretch" Padding="12"
              ToolTip="{Binding Path}" AutomationProperties.Name="{Binding Name}">
        <StackPanel>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Glyph}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                       Foreground="{DynamicResource Accent}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
          </Grid>
          <TextBlock Text="{Binding Path}" FontSize="11" Foreground="{DynamicResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,7" />
          <TextBlock Text="{Binding Snippet}" FontSize="13" FontWeight="Normal" TextWrapping="Wrap"
                     TextTrimming="WordEllipsis" MaxHeight="58" LineHeight="19">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Kind}" Value="Code">
                    <Setter Property="FontFamily" Value="Cascadia Code, Consolas" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
          <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Metadata}" FontWeight="Normal" FontSize="10" Foreground="{DynamicResource Muted}"
                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,8,0" />
            <Border Grid.Column="1" Background="{DynamicResource SuccessSurface}" CornerRadius="6" Padding="7,4">
              <TextBlock Text="{Binding ScoreLabel}" Foreground="{DynamicResource SuccessText}" FontSize="10" FontWeight="SemiBold" />
            </Border>
          </Grid>
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="*" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="32,22">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Width="50" Height="50" CornerRadius="12" Margin="0,0,16,0" Background="{DynamicResource Accent}">
          <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="25"
                     Foreground="{DynamicResource OnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Fuzzy Find Anything" FontSize="24" FontWeight="SemiBold" />
          <TextBlock Text="Semantic file search" Foreground="{DynamicResource Muted}" Margin="0,3,0,0" FontSize="13" />
        </StackPanel>
        <StackPanel Grid.Column="2" Width="200" Margin="16,0,24,0" VerticalAlignment="Center"
                    ToolTip="Percentage of completed startup checkpoints, not an estimate of time remaining."
                    Visibility="{Binding IsEngineLoading, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Text="{Binding StartupLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Ink}"
                     AutomationProperties.AutomationId="StartupPercentage" />
          <ProgressBar x:Name="StartupProgress" IsIndeterminate="False" Minimum="0" Maximum="100"
                       Value="{Binding StartupPercent, Mode=OneWay}" Height="4" Margin="0,6,0,0"
                       AutomationProperties.AutomationId="StartupProgress" AutomationProperties.Name="Loading search engine" />
          <TextBlock Text="{Binding StartupStage}" FontSize="11" Foreground="{DynamicResource Muted}" Margin="0,6,0,0"
                     TextTrimming="CharacterEllipsis" ToolTip="{Binding StartupStage}" />
        </StackPanel>
        <Border Grid.Column="2" CornerRadius="12" Padding="12,6" Margin="16,0,24,0" VerticalAlignment="Center"
                Visibility="{Binding ShowEngineState, Converter={StaticResource BoolToVisibility}}">
          <Border.Style>
            <Style TargetType="Border">
              <Setter Property="Background" Value="{DynamicResource WarningSurface}" />
              <Style.Triggers>
                <DataTrigger Binding="{Binding ModelState}" Value="Ready"><Setter Property="Background" Value="{DynamicResource SuccessSurface}" /></DataTrigger>
                <DataTrigger Binding="{Binding ModelState}" Value="Error"><Setter Property="Background" Value="{DynamicResource ErrorSurface}" /></DataTrigger>
              </Style.Triggers>
            </Style>
          </Border.Style>
          <TextBlock Text="{Binding ModelState}" FontSize="12" FontWeight="SemiBold" AutomationProperties.AutomationId="EngineState">
            <TextBlock.Style>
              <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding ModelState}" Value="Ready"><Setter Property="Foreground" Value="{DynamicResource SuccessText}" /></DataTrigger>
                  <DataTrigger Binding="{Binding ModelState}" Value="Error"><Setter Property="Foreground" Value="{DynamicResource ErrorText}" /></DataTrigger>
                </Style.Triggers>
              </Style>
            </TextBlock.Style>
          </TextBlock>
        </Border>
        <ToggleButton Grid.Column="3" x:Name="ThemeToggle" Content="Dark mode" IsChecked="{Binding IsDarkMode, Mode=OneWay}"
                      Checked="Theme_Changed" Unchecked="Theme_Changed" VerticalAlignment="Center" Margin="0,0,24,0"
                      IsEnabled="{Binding IsConfigurationIdle}"
                      AutomationProperties.AutomationId="ThemeToggle" AutomationProperties.Name="Dark mode"
                      AutomationProperties.ItemStatus="{Binding ThemeName}" ToolTip="Switch between light and dark appearance" />
        <Button Grid.Column="4" Content="Quit" Click="Quit_Click" Padding="16,9" VerticalAlignment="Center" IsEnabled="{Binding IsConfigurationIdle}"
                AutomationProperties.AutomationId="QuitButton" ToolTip="Stop background indexing and exit" />
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="{DynamicResource ErrorSurface}" BorderBrush="{DynamicResource ErrorLine}"
            BorderThickness="0,0,0,1" Padding="32,12"
            Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}" AutomationProperties.AutomationId="ErrorBanner">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Open logs" Click="OpenLog_Click" Padding="10,5" Margin="16,0,0,0" />
        <Button DockPanel.Dock="Right" Content="Dismiss" Click="DismissError_Click" Padding="10,5" Margin="16,0,0,0" />
        <TextBlock Text="{Binding Error}" Foreground="{DynamicResource ErrorText}" TextWrapping="Wrap" VerticalAlignment="Center" />
      </DockPanel>
    </Border>

    <TabControl Grid.Row="2" Margin="32,22,32,22" Background="Transparent" BorderThickness="0" SelectedIndex="0" FocusVisualStyle="{x:Null}"
                AutomationProperties.AutomationId="MainTabs">
      <TabControl.Template>
        <ControlTemplate TargetType="TabControl">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <TabPanel IsItemsHost="True" KeyboardNavigation.TabIndex="1" />
            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" Margin="0,24,0,0" ContentSource="SelectedContent" />
          </Grid>
        </ControlTemplate>
      </TabControl.Template>

      <TabItem AutomationProperties.AutomationId="SearchTab" AutomationProperties.Name="Search">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,2,9,0" />
            <TextBlock Text="Search" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <Grid TextElement.Foreground="{DynamicResource Ink}">
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" /><RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Search files" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Find indexed documents, code and images by their content." Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
          </StackPanel>
          <Border Grid.Row="1" Background="{DynamicResource Surface}" BorderThickness="1" CornerRadius="12" Padding="12,8" Margin="0,22,0,0">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
                <Style.Triggers>
                  <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource Accent}" /></Trigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="42" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
              <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="20"
                         Foreground="{DynamicResource Muted}" VerticalAlignment="Center" HorizontalAlignment="Center" />
              <Grid Grid.Column="1" Margin="4,0,14,0">
                <TextBox x:Name="SearchInput" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" BorderThickness="0"
                         Background="Transparent" FontSize="17" VerticalContentAlignment="Center" Padding="4,10"
                         MaxLength="2048" KeyDown="SearchInput_KeyDown"
                         AutomationProperties.AutomationId="SearchInput" AutomationProperties.Name="Search phrase" />
                <TextBlock Text="Describe a document, code or image" FontSize="17" Foreground="{DynamicResource Placeholder}"
                           Margin="4,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed" />
                      <Style.Triggers><DataTrigger Binding="{Binding Query}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Button Grid.Column="2" Content="Clear" Click="ClearSearch_Click" IsEnabled="{Binding CanClearSearch}"
                      Height="46" Margin="0,0,10,0" AutomationProperties.AutomationId="ClearSearchButton"
                      ToolTip="Clear the search phrase and results (Esc)" />
              <Button Grid.Column="3" Content="{Binding SearchButtonLabel}" Style="{StaticResource PrimaryButton}"
                      Width="120" Height="46" Click="Search_Click" IsEnabled="{Binding CanSearch}"
                      AutomationProperties.AutomationId="SearchButton" />
            </Grid>
          </Border>
          <Grid Grid.Row="2" Margin="0,12,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <TextBlock Text="Search scope: configured folders" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                        ToolTip="Cosine similarity, not a probability. Lower the threshold to include more results.">
              <TextBlock Text="Minimum similarity" Foreground="{DynamicResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0" />
              <Slider x:Name="SimilaritySlider" Value="{Binding Threshold, Mode=TwoWay}" Minimum="0" Maximum="0.9" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      ValueChanged="Similarity_Changed" IsEnabled="{Binding IsConfigurationIdle}" Width="110" VerticalAlignment="Center"
                      AutomationProperties.AutomationId="MinimumSimilarity" AutomationProperties.Name="Minimum similarity" />
              <TextBlock Text="{Binding Threshold, StringFormat=F2}" FontSize="12" Foreground="{DynamicResource Accent}" Margin="8,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
          </Grid>
          <TextBlock Grid.Row="3" Text="{Binding ResultSummary}" Foreground="{DynamicResource Muted}" FontSize="13" Margin="0,0,0,12" />
          <Grid Grid.Row="4">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"
                    Visibility="{Binding ShowEmpty, Converter={StaticResource BoolToVisibility}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <Border Width="64" Height="64" CornerRadius="16" Background="{DynamicResource AccentSurface}" HorizontalAlignment="Center" Margin="0,0,0,18">
                  <TextBlock Text="&#xE721;" Foreground="{DynamicResource Accent}" FontSize="28" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <TextBlock Text="{Binding EmptyTitle}" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"
                           AutomationProperties.AutomationId="EmptyResultsTitle" />
                <TextBlock Text="{Binding EmptyHint}" Foreground="{DynamicResource Muted}" Margin="0,8,0,0"
                           TextWrapping="Wrap" TextAlignment="Center" MaxWidth="560" />
              </StackPanel>
            </Border>
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsSearching, Converter={StaticResource BoolToVisibility}}">
              <ProgressBar IsIndeterminate="True" Width="240" Height="4" />
              <TextBlock Text="Searching the local index..." Margin="0,16,0,0" Foreground="{DynamicResource Muted}" />
            </StackPanel>
            <Grid Visibility="{Binding ShowResults, Converter={StaticResource BoolToVisibility}}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
                <ColumnDefinition Width="18" /><ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding DocumentHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Visibility="{Binding NoDocuments, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="No matching documents." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ListBox Grid.Row="1" x:Name="ResultsList" ItemsSource="{Binding DocumentResults}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         HorizontalContentAlignment="Stretch" KeyDown="Results_KeyDown" ItemContainerStyle="{StaticResource ResultItem}"
                         AutomationProperties.AutomationId="DocumentResults" ItemTemplate="{StaticResource TextResultTemplate}" />
              </Grid>
              <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding CodeHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Visibility="{Binding NoCode, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="No matching code." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding CodeResults}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         HorizontalContentAlignment="Stretch" KeyDown="Results_KeyDown" ItemContainerStyle="{StaticResource ResultItem}"
                         AutomationProperties.AutomationId="CodeResults" ItemTemplate="{StaticResource TextResultTemplate}" />
              </Grid>
              <Grid Grid.Column="4">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="{Binding ImageHeading}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />
                <Border Grid.Row="1" Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                        Visibility="{Binding NoImages, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="No matching images." Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
                <ListBox Grid.Row="1" x:Name="ImagesList" ItemsSource="{Binding ImageResults}" Background="Transparent" BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                         KeyDown="Images_KeyDown" AutomationProperties.AutomationId="ImageGallery">
                  <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                  <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource ResultItem}"><Setter Property="Margin" Value="0,0,10,10" /></Style>
                  </ListBox.ItemContainerStyle>
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <Button Width="180" Padding="10" HorizontalContentAlignment="Stretch" Click="Image_Click"
                              ToolTip="{Binding Result.Path}" AutomationProperties.Name="{Binding Result.Name}">
                        <StackPanel>
                          <Border Height="124" Background="{DynamicResource SubtleSurface}" CornerRadius="8">
                            <Grid>
                              <Image Source="{Binding Thumbnail}" Stretch="Uniform" Margin="4" AutomationProperties.Name="Image thumbnail"
                                     AutomationProperties.ItemStatus="{Binding ThumbnailStatus}" />
                              <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
                                          Visibility="{Binding HasNoThumbnail, Converter={StaticResource BoolToVisibility}}" Margin="8">
                                <TextBlock Text="&#xEB9F;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="28"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding ThumbnailMessage}" FontSize="10" FontWeight="Normal" Foreground="{DynamicResource Muted}"
                                           Margin="0,8,0,0" MaxHeight="32" TextWrapping="Wrap" TextAlignment="Center" />
                              </StackPanel>
                            </Grid>
                          </Border>
                          <TextBlock Text="{Binding Result.Name}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,10,2,5" />
                          <TextBlock Text="{Binding Result.ScoreLabel}" FontSize="11" FontWeight="Normal" Foreground="{DynamicResource SuccessText}" Margin="2,0" />
                          <TextBlock Text="{Binding Result.Metadata}" FontSize="10" FontWeight="Normal" Foreground="{DynamicResource Muted}" Margin="2,5,2,0" />
                        </StackPanel>
                      </Button>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </Grid>
          </Grid>
        </Grid>
      </TabItem>

      <TabItem AutomationProperties.AutomationId="FoldersTab" AutomationProperties.Name="Indexed folders">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,2,9,0" />
            <TextBlock Text="Indexed folders" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <Grid TextElement.Foreground="{DynamicResource Ink}">
          <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="Indexed folders" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Documents, code and images in these folders and their subfolders are indexed automatically."
                       Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
          </StackPanel>
          <Grid Grid.Row="1" Margin="0,22,0,20">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource PrimaryButton}" Click="AddFolder_Click" IsEnabled="{Binding CanManageFolders}" AutomationProperties.AutomationId="AddFolderButton" AutomationProperties.Name="Add folder">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE710;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource OnAccent}" Margin="0,2,9,0" />
                <TextBlock Text="Add folder" Foreground="{DynamicResource OnAccent}" />
              </StackPanel>
            </Button>
            <Button Grid.Column="1" Content="{Binding RemoveLabel}" Click="RemoveFolders_Click" IsEnabled="{Binding CanRemove}"
                    Foreground="{DynamicResource ErrorText}" Margin="10,0,0,0" AutomationProperties.AutomationId="RemoveFolderButton" />
            <TextBlock Grid.Column="2" Text="Removing a folder does not delete its files." Foreground="{DynamicResource Muted}"
                       FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
          </Grid>
          <Grid Grid.Row="2">
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="12"
                    Visibility="{Binding NoFolders, Converter={StaticResource BoolToVisibility}}">
              <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <TextBlock Text="&#xE8B7;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{DynamicResource Accent}" FontSize="42" HorizontalAlignment="Center" Margin="0,0,0,18" />
                <TextBlock Text="No folders configured" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Text="Add a folder to begin indexing documents, code and images."
                           TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" Margin="0,9,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="10" Padding="1"
                    Visibility="{Binding HasFolders, Converter={StaticResource BoolToVisibility}}">
              <DataGrid ItemsSource="{Binding Folders}" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                        CanUserReorderColumns="False" CanUserResizeRows="False" CanUserResizeColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                        GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{DynamicResource Line}" Background="{DynamicResource Surface}" BorderThickness="0"
                        Foreground="{DynamicResource Ink}" RowHeaderWidth="0" MinRowHeight="92" SelectionMode="Single" SelectionUnit="FullRow"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="FoldersList">
                <DataGrid.Columns>
                  <DataGridTemplateColumn Width="52">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" HorizontalAlignment="Center"
                                VerticalAlignment="Center" AutomationProperties.Name="{Binding Path, StringFormat='Select {0} for removal'}" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Folder" Width="2.1*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <StackPanel VerticalAlignment="Center" Margin="12">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" />
                        <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                      </StackPanel>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Status" Width="160">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <StackPanel VerticalAlignment="Center" Margin="12">
                        <Border CornerRadius="6" Padding="9,4" HorizontalAlignment="Left">
                          <Border.Style><Style TargetType="Border">
                            <Setter Property="Background" Value="{DynamicResource WarningSurface}" />
                            <Style.Triggers><DataTrigger Binding="{Binding IsIndexed}" Value="True"><Setter Property="Background" Value="{DynamicResource SuccessSurface}" /></DataTrigger></Style.Triggers>
                          </Style></Border.Style>
                          <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="SemiBold">
                            <TextBlock.Style><Style TargetType="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource WarningText}" />
                              <Style.Triggers><DataTrigger Binding="{Binding IsIndexed}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SuccessText}" /></DataTrigger></Style.Triggers>
                            </Style></TextBlock.Style>
                          </TextBlock>
                        </Border>
                        <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate}" Maximum="100" Height="3" Margin="0,9,0,5" />
                        <TextBlock Text="{Binding ProgressLabel}" FontSize="10" Foreground="{DynamicResource Muted}" />
                      </StackPanel>
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                  <DataGridTemplateColumn Header="Indexing details" Width="1.5*">
                    <DataGridTemplateColumn.CellTemplate><DataTemplate>
                      <TextBlock Text="{Binding Detail}" Foreground="{DynamicResource Muted}" FontSize="13"
                                 VerticalAlignment="Center" Margin="12" AutomationProperties.AutomationId="FolderIndexingDetails" />
                    </DataTemplate></DataGridTemplateColumn.CellTemplate>
                  </DataGridTemplateColumn>
                </DataGrid.Columns>
              </DataGrid>
            </Border>
          </Grid>
          <TextBlock Grid.Row="3" Text="{Binding FolderSummary}" FontSize="12" Foreground="{DynamicResource Muted}" Margin="0,16,0,0" />
        </Grid>
      </TabItem>

      <TabItem AutomationProperties.AutomationId="IndexInfoTab" AutomationProperties.Name="Index information">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,2,9,0" />
            <TextBlock Text="Index information" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Ink}" AutomationProperties.AutomationId="IndexMetadataPanel">
          <StackPanel>
            <TextBlock Text="Vector index" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Storage and indexing statistics. Updated automatically."
                       Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
            <Border Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Line}" BorderThickness="1" Padding="28" Margin="0,22,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="235" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                  <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.Resources><Style TargetType="TextBlock">
                  <Setter Property="Margin" Value="0,14" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="FontSize" Value="16" />
                </Style></Grid.Resources>
                <TextBlock Text="Vector index type" Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Column="1" Text="{Binding IndexType}" FontWeight="SemiBold" AutomationProperties.AutomationId="IndexTypeValue" />
                <TextBlock Grid.Row="1" Text="Index DB location" Foreground="{DynamicResource Muted}" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IndexLocation, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                         BorderThickness="0" Background="Transparent" FontSize="14" Padding="0" VerticalAlignment="Center"
                         AutomationProperties.AutomationId="IndexLocationValue" />
                <TextBlock Grid.Row="2" Text="Total files in DB" Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TotalFiles}" FontSize="22" FontWeight="SemiBold" AutomationProperties.AutomationId="TotalFilesValue" />
                <TextBlock Grid.Row="3" Text="Total documents" Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding TotalDocuments}" FontWeight="SemiBold" AutomationProperties.AutomationId="TotalDocumentsValue" />
                <TextBlock Grid.Row="4" Text="Total code files" Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding TotalCodeFiles}" FontWeight="SemiBold" AutomationProperties.AutomationId="TotalCodeFilesValue" />
                <TextBlock Grid.Row="5" Text="Total images" Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding TotalImages}" FontWeight="SemiBold" AutomationProperties.AutomationId="TotalImagesValue" />
                <TextBlock Grid.Row="6" Text="Database size" Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding DatabaseSize}" FontWeight="SemiBold" AutomationProperties.AutomationId="DatabaseSizeValue"
                           ToolTip="Catalog, queued passage checkpoints and DiskANN files. Excludes models, runtime and logs." />
                <TextBlock Grid.Row="7" Text="Index last refreshed" Foreground="{DynamicResource Muted}" />
                <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding LastRefreshed}" FontWeight="SemiBold"
                           AutomationProperties.AutomationId="LastRefreshedValue" ToolTip="{Binding RefreshTimestamp}" />
              </Grid>
            </Border>
            <Border Background="{DynamicResource AccentSurface}" CornerRadius="10" Padding="18,14" Margin="0,16,0,0">
              <StackPanel>
                <TextBlock Text="Change monitoring" FontWeight="SemiBold" Foreground="{DynamicResource Accent}" />
                <TextBlock Text="{Binding Monitor}" Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" FontSize="12" />
                <TextBlock Text="File counts include successfully indexed content." Foreground="{DynamicResource Muted}" Margin="0,5,0,0" FontSize="12" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem AutomationProperties.AutomationId="ConfigurationTab" AutomationProperties.Name="Configuration">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,2,9,0" />
            <TextBlock Text="Configuration" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Ink}">
          <StackPanel>
            <TextBlock Text="Configuration" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Manage local logging and application preferences." Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
            <Border Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" Padding="28" Margin="0,22,0,0">
              <StackPanel>
                <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel>
                    <TextBlock Text="Indexer logging" FontSize="18" FontWeight="SemiBold" />
                    <TextBlock Text="Record file outcomes, processing time and error details." Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
                  </StackPanel>
                  <ToggleButton Grid.Column="1" x:Name="LoggingToggle" Content="{Binding LoggingLabel}"
                                IsChecked="{Binding LoggingEnabled, Mode=OneWay}" IsEnabled="{Binding CanConfigure}"
                                Checked="Logging_Changed" Unchecked="Logging_Changed" VerticalAlignment="Center" Margin="24,0,0,0"
                                AutomationProperties.AutomationId="LoggingToggle" AutomationProperties.Name="Indexer logging"
                                AutomationProperties.ItemStatus="{Binding LoggingLabel}" />
                </Grid>
                <Border Height="1" Background="{DynamicResource Line}" Margin="0,24" />
                <TextBlock Text="Log location" FontWeight="SemiBold" />
                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox Text="{Binding LogDirectory, Mode=OneWay}" IsReadOnly="True" Background="{DynamicResource SubtleSurface}"
                           VerticalContentAlignment="Center" TextWrapping="Wrap" AutomationProperties.AutomationId="LogDirectory" />
                  <Button Grid.Column="1" Content="Change..." Click="ChangeLogDirectory_Click" IsEnabled="{Binding CanConfigure}"
                          Margin="12,0,0,0" AutomationProperties.AutomationId="ChangeLogDirectoryButton" />
                  <Button Grid.Column="2" Content="Open folder" Click="OpenLog_Click" Margin="12,0,0,0"
                          AutomationProperties.AutomationId="OpenLogDirectoryButton" />
                </Grid>
                <TextBlock Text="New records use the selected location. Existing logs are retained."
                           Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
            <Border Background="{DynamicResource Surface}" CornerRadius="12" BorderBrush="{DynamicResource Line}"
                    BorderThickness="1" Padding="28" Margin="0,18,0,0">
              <StackPanel>
                <TextBlock Text="Configuration file" FontSize="18" FontWeight="SemiBold" />
                <TextBox Text="{Binding SettingsPath, Mode=OneWay}" IsReadOnly="True" Background="Transparent" BorderThickness="0"
                         Padding="0" TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.AutomationId="SettingsFilePath" />
                <TextBlock Text="Preferences are saved automatically in XML format."
                           Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,10,0,0" />
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem AutomationProperties.AutomationId="ModelsTab" AutomationProperties.Name="Model configuration">
        <TabItem.Header>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8F1;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" Margin="0,2,9,0" />
            <TextBlock Text="Model configuration" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=TabItem}}" />
          </StackPanel>
        </TabItem.Header>
        <ScrollViewer VerticalScrollBarVisibility="Auto" Foreground="{DynamicResource Ink}">
          <StackPanel>
            <TextBlock Text="Model configuration" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Choose a Hugging Face embedding model for each file type." Foreground="{DynamicResource Muted}" Margin="0,6,0,0" />
            <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                    CornerRadius="12" Padding="28" Margin="0,22,0,0">
              <StackPanel>
                <TextBlock Text="Documents / text" FontWeight="SemiBold" />
                <TextBox Text="{Binding TextModelUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsConfigurationIdle}"
                         Margin="0,8,0,18" AutomationProperties.AutomationId="TextModelUrl" AutomationProperties.Name="Text model Hugging Face URL" />
                <TextBlock Text="Source code" FontWeight="SemiBold" />
                <TextBox Text="{Binding CodeModelUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsConfigurationIdle}"
                         Margin="0,8,0,18" AutomationProperties.AutomationId="CodeModelUrl" AutomationProperties.Name="Code model Hugging Face URL" />
                <TextBlock Text="Images" FontWeight="SemiBold" />
                <TextBox Text="{Binding ImageModelUrl, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsConfigurationIdle}"
                         Margin="0,8,0,18" AutomationProperties.AutomationId="ImageModelUrl" AutomationProperties.Name="Image model Hugging Face URL" />
                <TextBlock Text="Matching model assignments share an index. Only affected embeddings are replaced when you apply a change."
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" />
                <TextBlock Text="A model must provide a supported native ONNX embedding export and pass local CPU, GPU or NPU execution checks. No hosted inference or remote model code is used."
                           TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,0" />
                <TextBlock Text="{Binding ModelConfigurationMessage}" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"
                           AutomationProperties.AutomationId="ModelConfigurationStatus" />
              </StackPanel>
            </Border>
            <TextBlock Text="Active indexes and execution devices" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,12" />
            <ItemsControl ItemsSource="{Binding ModelIndexes}" AutomationProperties.AutomationId="ModelIndexList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="1"
                          CornerRadius="8" Padding="16" Margin="0,0,0,10">
                    <StackPanel>
                      <TextBlock Text="{Binding ModelUrl}" FontWeight="SemiBold" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding KindLabel}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" />
                      <TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Directory}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,5,0,0" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Button Content="Apply model changes" Click="ApplyModels_Click" IsEnabled="{Binding CanApplyModels}"
                    Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Margin="0,16,0,24"
                    AutomationProperties.AutomationId="ApplyModelsButton" />
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>

    <Border Grid.Row="3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="32,12">
      <Grid x:Name="StatusBar">
        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Text="{Binding EngineMessage}" ToolTip="{Binding EngineMessage}" FontSize="12" Foreground="{DynamicResource Muted}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="IndexingActivity" />
        <TextBlock Grid.Column="1" Text="{Binding Counts}" FontSize="12" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="20,0,0,0"
                   AutomationProperties.AutomationId="IndexCounts" />
        <Border Grid.Column="2" Background="{DynamicResource SubtleSurface}" CornerRadius="6" Padding="10,6" Margin="20,0,0,0" VerticalAlignment="Center" ToolTip="{Binding CpuDetail}">
          <TextBlock Text="{Binding CpuSummary}" FontSize="11" Foreground="{DynamicResource Muted}" AutomationProperties.AutomationId="CpuBudget" />
        </Border>
        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
          <TextBlock Text="&#xA9; 2026 Suman Ghosh" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center"
                     AutomationProperties.AutomationId="Attribution" />
          <Button Width="30" Height="28" Padding="4" Margin="12,0,2,0" Background="Transparent" BorderBrush="Transparent"
                  Foreground="{DynamicResource Muted}" Click="Profile_Click" Tag="https://www.linkedin.com/in/ghoshsuman/"
                  ToolTip="Suman Ghosh on LinkedIn" AutomationProperties.AutomationId="LinkedInLink"
                  AutomationProperties.Name="LinkedIn profile for Suman Ghosh" AutomationProperties.HelpText="https://www.linkedin.com/in/ghoshsuman/">
            <TextBlock Text="in" FontWeight="Bold" FontSize="16" />
          </Button>
          <Button Width="30" Height="28" Padding="4" Background="Transparent" BorderBrush="Transparent"
                  Foreground="{DynamicResource Muted}" Click="Profile_Click" Tag="https://github.com/sumanthewhiz"
                  ToolTip="sumanthewhiz on GitHub" AutomationProperties.AutomationId="GitHubLink"
                  AutomationProperties.Name="GitHub profile for sumanthewhiz" AutomationProperties.HelpText="https://github.com/sumanthewhiz">
            <Grid Width="20" Height="20">
              <Path Data="M 5,5 L 5,15 M 15,5 L 15,8 C 15,12 5,8 5,14"
                    Stroke="{DynamicResource Muted}" StrokeThickness="1.7" />
              <Ellipse Width="5" Height="5" Stroke="{DynamicResource Muted}" StrokeThickness="1.7" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="2.5,1" />
              <Ellipse Width="5" Height="5" Stroke="{DynamicResource Muted}" StrokeThickness="1.7" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,1,2.5,0" />
              <Ellipse Width="5" Height="5" Stroke="{DynamicResource Muted}" StrokeThickness="1.7" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="2.5,0,0,1" />
            </Grid>
          </Button>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
