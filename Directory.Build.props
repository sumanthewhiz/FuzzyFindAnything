<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>2.0.0</Version>
    <Product>FuzzyFindAnything 2.0</Product>
    <Authors>Suman Ghosh</Authors>
    <Company>Suman Ghosh</Company>
    <Copyright>Copyright (c) 2026 Suman Ghosh</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/sumanthewhiz/FuzzyFindAnything</RepositoryUrl>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
</Project>
